# QiPay 插件运行参数模板（P4-03）
# 复制后按现场修改。不要改框架的 backend/.env.example，也不要覆盖开发机的 backend/.env。
# 本文件给 docker compose 用：数据库主机名是编排里的服务名，不是 127.0.0.1。
#
# 同一文件里这三组必须彼此相等，改一处就要改对应的另一处：
#   DATABASE_USER / DATABASE_PASSWORD / DATABASE_SCHEMA
#     = POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   CELERY_RABBITMQ_USERNAME / CELERY_RABBITMQ_PASSWORD
#     = RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS
# 上线前把 TOKEN_SECRET_KEY 换成：openssl rand -base64 32

# 框架在 prod 下会关闭 OpenAPI，并把 Celery broker 固定为 rabbitmq、打开指标导出。
ENVIRONMENT='prod'

# Database
DATABASE_TYPE='postgresql'
DATABASE_HOST='postgres'
DATABASE_PORT=5432
DATABASE_USER='qipay'
DATABASE_PASSWORD='qipay-change-me'
DATABASE_SCHEMA='fba'
DATABASE_PK_MODE='autoincrement'
DATABASE_SOURCES='{}'

# 仅给 postgres 镜像读取，后端会忽略这些多余变量。
POSTGRES_USER='qipay'
POSTGRES_PASSWORD='qipay-change-me'
POSTGRES_DB='fba'

# Redis（容器内无密码；不要把 6379 暴露到公网）
REDIS_HOST='redis'
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_DATABASE=0

# Token
TOKEN_SECRET_KEY='CHANGE_ME_openssl_rand_base64_32'
# 访问令牌有效期（秒）。框架默认 86400（1 天），这里改成 8 小时。
# H5 把 access token 放在 localStorage，且不刷新（纲要 §10 #24，401 就重新登录）。
# 缩短有效期是为了缩小 token 被偷走之后还能用的时间。
# 这是全局参数，管理端签发的 access token 一起变短。管理端会用 httpOnly refresh cookie
# 调 /api/v1/auth/refresh 静默换新，刷新令牌仍是框架默认 7 天（不要在这里改
# TOKEN_REFRESH_EXPIRE_SECONDS，否则管理端的免登录时长会一起被缩短，而且帮不到 H5）。
# 取舍：8 小时能覆盖一个班次。再短到 2 小时（7200）窗口更小，但骑手一个班次要登多次，
# 验证码接口大约 5 次/30 秒，频繁刷新容易碰到限流。H5 到期后必须重新登录。
TOKEN_EXPIRE_SECONDS=28800

# Celery。ENVIRONMENT=prod 时框架忽略 redis broker，强制走 RabbitMQ。
CELERY_BROKER_REDIS_DATABASE=1
CELERY_RABBITMQ_HOST='rabbitmq'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_USERNAME='qipay'
CELERY_RABBITMQ_PASSWORD='qipay-change-me'
RABBITMQ_DEFAULT_USER='qipay'
RABBITMQ_DEFAULT_PASS='qipay-change-me'

# 指标导出端点。现场没有 Alloy 时导出会重试，不阻断启动；有采集器再改成它的地址。
GRAFANA_OTLP_GRPC_ENDPOINT='127.0.0.1:4317'

# CORS：同域部署本身不需要跨域。这里放行本地管理端 5173 和骑手 H5 5174，
# 方便开发服务器直连生产或预发 API。末尾不要加斜杠。
CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]'
# 浏览器才能读到导出文件名。保留框架原有的 X-Request-ID。
CORS_EXPOSE_HEADERS='["X-Request-ID","Content-Disposition"]'

# 框架必填、QiPay 用不到的插件占位。留空即可。
OAUTH2_GITHUB_CLIENT_ID=''
OAUTH2_GITHUB_CLIENT_SECRET=''
OAUTH2_GOOGLE_CLIENT_ID=''
OAUTH2_GOOGLE_CLIENT_SECRET=''
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
